{
  "name": "animation-framework",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck",
    "test": "pnpm -r --filter=./packages/* run test",
    "test:golden": "pnpm -r --filter=./packages/* run test:golden",
    "test:parity": "pnpm -r --filter=./packages/* run test:parity",
    "test:import": "pnpm -r --filter=./packages/* run test:import",
    "bench": "pnpm -r --filter=./packages/* run bench",
    "test:spine:import": "pnpm -r --filter=./packages/* run test:spine:import",
    "test:spine:golden": "pnpm -r --filter=./packages/* run test:spine:golden",
    "test:spine:parity": "pnpm -r --filter=./packages/* run test:spine:parity",
    "test:spine:perf": "pnpm -r --filter=./packages/* run test:spine:perf",
    "test:spine": "pnpm -r --filter=./packages/* run test:spine",
    "fetch:spine-samples": "node scripts/fetch-spine-samples.mjs",
    "test:spine:samples": "pnpm -C packages/render-engine test:spine:samples"
  },
  "devDependencies": {
    "@esotericsoftware/spine-canvas": "4.3.13",
    "@napi-rs/canvas": "1.2.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  }
}
