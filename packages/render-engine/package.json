{
  "name": "@animation-framework/render-engine",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:golden": "jest --testPathPatterns='acceptance/golden'",
    "test:parity": "jest --testPathPatterns='acceptance/parity'",
    "test:import": "jest --testPathPatterns='acceptance/import-corpus|asset'",
    "bench": "jest --testPathPatterns='acceptance/bench'",
    "test:spine:import": "jest --testPathPatterns='asset|acceptance/import'",
    "test:spine:golden": "jest --testPathPatterns='acceptance/golden|acceptance/parity'",
    "test:spine:parity": "jest --testPathPatterns='acceptance/parity|render/webgl-blend'",
    "test:spine:perf": "jest --testPathPatterns='acceptance/(bench|perf-budget)'",
    "test:spine": "jest --testPathPatterns='asset|acceptance|render/(region-geometry|webgl-blend|clipping|two-color|shader-variants)|runtime/(sequence|api-parity|animation-integration|clipping-integration)'",
    "test:spine:samples": "jest --testPathPatterns='acceptance/spine-samples'"
  },
  "dependencies": {
    "gl-matrix": "3.4.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  }
}
